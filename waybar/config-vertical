{
    "include": "modules.json",

    "layer": "top",
    "position": "left",
    "width": 56,
    "modules-left": [
        "custom/os-icon",
        "clock",
        "sway/workspaces",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "network",
        "battery"
    ],
    "modules-center": [],
    "modules-right": ["custom/power"],

    "clock": {
        "interval": 60,
        "format": "{:%H\n%M}",
        "format-alt": "󰃭 {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "interval": 2,
        "format": "{icon}",
        "format-icons": ["󰻠"],
        "tooltip": true,
        "tooltip-format": "CPU: {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "interval": 5,
        "format": "󰍛",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": "{icon}",
        "format-icons": ["󰔏", "󱃃", "󰸁"],
        "tooltip-format": "{temperatureC}°C"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "Volume: {volume}%",
        "on-click": "pavucontrol"
    },

    "network": {
        "interval": 5,
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{signalStrength}% - {essid}/{ipaddr}",
        "tooltip-format-ethernet": "{ifname}/{ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nmtui"
    },

    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Battery: {capacity}%"
    }
}
